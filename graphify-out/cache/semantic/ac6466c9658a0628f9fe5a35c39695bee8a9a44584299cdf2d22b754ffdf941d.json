{"nodes": [{"id": "pages_bulkpage_bulkpage", "label": "BulkPage", "file_type": "code", "source_file": "resources/admin/Pages/BulkPage.jsx", "source_location": "L260", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server is the authority on run state; reconciles on mount and polls every 4s while busy because cron and other tabs also advance batches. First scan is started from the client, not PHP enqueue, so drawing a page never kicks off minutes of batched work."}, {"id": "pages_bulkpage_absorb", "label": "BulkPage.absorb()", "file_type": "code", "source_file": "resources/admin/Pages/BulkPage.jsx", "source_location": "L279", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Snapshot travels in the same response as run state so ring and progress bar describe the same instant."}, {"id": "pages_bulkpage_pumpscan", "label": "BulkPage.pumpScan()", "file_type": "code", "source_file": "resources/admin/Pages/BulkPage.jsx", "source_location": "L370", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drives scan batches while a tab is open; scan-locked/not-scanning errors mean cron or another tab took the batch and are not failures."}, {"id": "pages_bulkpage_pumpbulk", "label": "BulkPage.pumpBulk()", "file_type": "code", "source_file": "resources/admin/Pages/BulkPage.jsx", "source_location": "L415", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pages_bulkpage_startscan", "label": "BulkPage.startScan()", "file_type": "code", "source_file": "resources/admin/Pages/BulkPage.jsx", "source_location": "L445", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pages_bulkpage_startoptimize", "label": "BulkPage.startOptimize()", "file_type": "code", "source_file": "resources/admin/Pages/BulkPage.jsx", "source_location": "L477", "source_url": null, "captured_at": null, "author": null,